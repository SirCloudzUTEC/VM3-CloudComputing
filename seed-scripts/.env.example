# Variables de conexion para los scripts de carga masiva de seed-scripts/.
#
# Cada script python lee DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME (SQL)
# o MONGO_URI/MONGO_DB (Mongo) -- el mismo naming que usan los
# microservicios de VM1/VM2 para conectarse a esta VM (ver
# VM1/*/app/db.py y VM1/*/.env.example).
#
# Como run_all.sh ejecuta 4 scripts contra 3 motores/bases distintas en
# secuencia, NO uses este archivo tal cual con `source .env` para correr
# un script individual salvo que sea inventario_db (el DB_NAME de abajo).
# run_all.sh ya resuelve esto por ti leyendo las variables MYSQL_*/
# POSTGRES_*/MONGO_* de VM3/.env (o de un .env aqui mismo) y exportando el
# DB_NAME correcto antes de cada paso -- ver ese script para el detalle.
#
# Para correr UN script suelto a mano (ej. contra otra base), exporta las
# 5 variables antes de invocarlo, por ejemplo:
#   DB_HOST=localhost DB_PORT=3306 DB_USER=bodega DB_PASSWORD=changeme \
#     DB_NAME=proveedores_db python seed_proveedores.py

# --- Valores por defecto (ejemplo: seed_inventario.py / MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=bodega
DB_PASSWORD=changeme
DB_NAME=inventario_db

# --- Alternativa para seed-scripts/run_all.sh (recomendado): usa estas,
# con el mismo naming que VM3/.env.example, y deja que run_all.sh arme
# DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME por cada paso. ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=bodega
MYSQL_PASSWORD=changeme

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bodega
POSTGRES_PASSWORD=changeme

# --- MongoDB (prediccion_db) ---
MONGO_URI=mongodb://bodega:changeme@localhost:27017/prediccion_db
MONGO_DB=prediccion_db
