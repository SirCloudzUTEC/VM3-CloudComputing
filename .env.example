# Credenciales de las bases de datos de VM3.
# Copia este archivo como .env en VM3/ para levantar los contenedores.
# IMPORTANTE: DB_USER=bodega / DB_PASSWORD=changeme es el mismo usuario que
# ya esperan los microservicios de VM1 (inventario-api, proveedores-api,
# ventas-api — ver sus .env.example) para conectarse a esta VM. Si cambias
# MYSQL_PASSWORD/POSTGRES_PASSWORD aqui, actualiza tambien DB_PASSWORD en
# los .env de esos microservicios.

# --- MySQL (inventario_db, proveedores_db) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_USER=bodega
MYSQL_PASSWORD=changeme

# --- PostgreSQL (ventas_db) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bodega
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ventas_db

# --- MongoDB (prediccion_db) ---
# MONGO_ROOT_USER/PASSWORD: usuario admin de la instancia (solo lo lee
# docker-compose.yml). MONGO_USER/PASSWORD: usuario de aplicacion 'bodega'
# que crea mongo/init/01-init-prediccion.js, con permisos scoped a
# prediccion_db -- es el que usa prediccion-api (VM2) para conectarse, ver
# MONGO_URI mas abajo (incluye credenciales + /prediccion_db como
# authSource implicito).
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme_root
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=bodega
MONGO_PASSWORD=changeme
MONGO_URI=mongodb://bodega:changeme@localhost:27017/prediccion_db
MONGO_DB=prediccion_db
